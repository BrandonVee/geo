POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://geo:geo@localhost:5432/geo
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
# 仅供迁移、种子和 RLS 发布任务使用；生产环境必须使用独立迁移身份。
MIGRATION_DATABASE_URL=postgresql://geo:geo@localhost:5432/geo
# PostgreSQL 连接标识、业务连接池和 pg-boss 连接池上限。
DB_APPLICATION_NAME=answerbit-geo-local
DB_POOL_MAX=10
JOB_DB_POOL_MAX=5
# 空闲连接回收、连接建立、单次查询和连接最长生命周期。
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_SECONDS=300
APP_URL=http://localhost:3000
# 构建或发布版本，用于 Worker 心跳与运行健康识别。
APP_VERSION=development
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# 逗号分隔；从局域网地址打开开发站点时，需要将对应 Origin 加入此处。
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://172.21.245.33:3000
ANSWERBIT_BASE_URL=https://answerbit.qq.com
# 小青蛙 API 聚合发布兼容回退；推荐部署后在平台“发布履约”网页验证并加密保存，数据库配置优先。
FROG_PUBLICATION_BASE_URL=http://8.138.187.158:8082
FROG_PUBLICATION_API_KEY=
