{
  "name": "answerbit-geo-saas",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs pnpm --parallel --filter @geo/web --filter @geo/worker dev",
    "dev:web": "node scripts/run-with-env.mjs pnpm --filter @geo/web dev",
    "build": "node scripts/run-with-env.mjs pnpm -r build",
    "lint": "pnpm -r lint",
    "format:backend": "prettier --write 'apps/web/src/server/**/*.ts' 'apps/web/src/app/api/**/*.ts' 'apps/worker/src/**/*.ts' 'packages/{config,db,contracts,core,publication}/src/**/*.ts'",
    "format:check": "prettier --check 'apps/web/src/server/**/*.ts' 'apps/web/src/app/api/**/*.ts' 'apps/worker/src/**/*.ts' 'packages/{config,db,contracts,core,publication}/src/**/*.ts'",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "node scripts/run-with-env.mjs pnpm --filter @geo/db generate",
    "db:migrate": "node scripts/run-with-env.mjs pnpm --filter @geo/db migrate",
    "db:release": "node scripts/run-with-env.mjs node scripts/release-database.mjs",
    "worker": "node scripts/run-with-env.mjs pnpm --filter @geo/worker start",
    "worker:prod": "node scripts/run-with-env.mjs pnpm --filter @geo/worker start:prod",
    "smoke:web": "node scripts/smoke-web.mjs",
    "install:docker": "bash scripts/install-docker.sh",
    "db:seed": "node scripts/run-with-env.mjs pnpm --filter @geo/db seed",
    "db:grant-admin": "node scripts/run-with-env.mjs pnpm --filter @geo/db grant-admin",
    "db:rls-check": "node scripts/run-with-env.mjs pnpm --filter @geo/db rls-check"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "tslib": "2.8.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "axe-core": "4.13.0",
    "prettier": "3.6.2"
  }
}
